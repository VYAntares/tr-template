# Copy to .env and edit:  cp .env.example .env
#
# .env is gitignored and CI fails the build if it is ever staged. This file is
# the source of truth for variable NAMES: a hygiene job diffs the keys here
# against the keys in .env, so a new variable has to be added to both. Values
# below are non-secret local defaults and are safe to commit.
#
# Every key is read by compose.yml. Nothing else picks a variable up implicitly,
# so a variable that is not passed to a service in that file does nothing.

# --- runtime -----------------------------------------------------------------

# development for the dev stack, production for compose.prod.yml. The prod
# overlay hardcodes production, so this value only affects `docker compose up`.
NODE_ENV=development

# Reported by GET /api/health. Read through ConfigService, so the hygiene script
# cannot detect it by grepping for process.env: keep this entry by hand. CI can
# override it with the image tag to identify which build is running.
APP_VERSION=0.0.0

# --- postgres ----------------------------------------------------------------

# Role created on the database's first boot. Changing it later does nothing
# until the pg-data volume is recreated: the credentials are baked in at init.
POSTGRES_USER=ft

# Local development only. Anything that leaves a laptop needs a real secret,
# and it belongs in .env, never here.
POSTGRES_PASSWORD=ft_local_dev

# Database created on the container's first boot, and the one DATABASE_URL below
# points at.
POSTGRES_DB=template_app

# What Prisma connects with. Host `db` is the compose service name, reachable
# only from inside the network, so this URL does not work from the host shell.
# Nothing derives it from the three variables above: keep them in sync by hand.
DATABASE_URL=postgresql://ft:ft_local_dev@db:5432/template_app?schema=public

# --- redis -------------------------------------------------------------------

# Backs the rate-limiter counters, and whatever caching or queueing you add.
REDIS_URL=redis://redis:6379

# --- service to service ------------------------------------------------------

# Where Next.js server components reach NestJS. Plain http and no public port:
# TLS terminates at caddy and this hop never leaves the docker network.
API_INTERNAL_URL=http://api:3001

# --- proxy / remote access -----------------------------------------------------

# Ports caddy publishes on the host. Defaults are the standard ones; on a
# machine that cannot bind ports below 1024 (rootless Docker without sudo) set
# e.g. 8080/8443 and open https://localhost:8443 directly.
# The automatic http->https redirect only exists on the default ports.
HTTP_PORT=80
HTTPS_PORT=443

# Extra hostname caddy serves, for reaching a stack that runs on another machine
# (server on one box, browser on your laptop). On YOUR device:
#   1. echo "<server-lan-ip> template-app.test" | sudo tee -a /etc/hosts
#   2. trust certs/ft-local-root.crt in the browser (make certs prints how)
# .test is reserved by RFC 6761 and never resolves publicly, so the made-up name
# cannot collide with a real site. Rename it for your own project.
CADDY_EXTRA_HOSTNAME=template-app.test

# --- devcontainer --------------------------------------------------------------

# Host-side path of this repository. Compose resolves relative bind mounts on
# the docker DAEMON's side (the host), so compose commands run from INSIDE the
# devcontainer need this to point the mounts at the real host path.
# devcontainer.json injects it into container shells automatically; leave it
# empty here and on the host, where the compose fallback "." is already correct.
LOCAL_WORKSPACE_FOLDER=
